    "video": "https://player.vimeo.com/video/899284463?title=0&byline=0&portrait=0&loop=1&autopause=0",
    "body": "\n            <h1 class=\"h1-md\">Pikmin XR</h1>\n            <div class=\"tags-container work-tags\" style=\"display: inline-block;\"><ul><li class=\"tag\">game</li><li class=\"tag\">mixed reality</li></ul></div><p class=\"caption\">\n              This is a project exploring how existing 3D game mechanics can be\n              borrowed and adapted to create more intuitive and immersive\n              gameplay in mixed reality. Using the Pikmin game series as an\n              example, I reproduced various classic interactions in passthrough,\n              such as Throw and Pluck, that introduce some alternative\n              interaction patterns in XR.\n            </p>\n            <h2>\n              <a href=\"https://github.com/ellenlowing/PikminPassthrough\" target=\"_blank\">Read code</a>\n            </h2>\n          ",
    "slug": "pikmin-xr",
    "thumb": "/assets/images/work/pikmin-xr.jpg",
    "homepage_card_html": "<a class=\"work-card\" href=\"/work/pikmin-xr/\" data-tags=\"game xr\"><div class=\"work-image\"><img src=\"/assets/images/work/pikmin-xr.jpg?v=grid\" alt=\"\" loading=\"lazy\" width=\"1280\" height=\"1280\"></div><h3>Pikmin XR</h3></a>",
    "archived_on": "2026-11-18",
    "detail_path": "work/pikmin-xr/index.html",
    "detail_html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Pikmin XR — Ellen Lo</title><meta name=\"description\" content=\"Games, mixed reality, and interactive work by Ellen Lo.\"><link rel=\"stylesheet\" href=\"/assets/css/project.css?v=grid\"><link rel=\"stylesheet\" href=\"/assets/css/home.css?v=grid\"></head><body class=\"home-page\"><a class=\"skip-link\" href=\"#main\">Skip to content</a><div class=\"page-frame\"><header class=\"site-header\"><a class=\"wordmark\" href=\"/\">Ellen Lo</a><a href=\"mailto:ellenlowing@gmail.com\">say hi 💌</a></header><main id=\"main\"><article class=\"work-detail\"><h1>Pikmin XR</h1><div class=\"detail-video\"><iframe src=\"https://player.vimeo.com/video/899284463?title=0&amp;byline=0&amp;portrait=0&amp;loop=0&amp;autopause=0\" title=\"Pikmin XR video\" loading=\"lazy\" allow=\"autoplay; fullscreen; picture-in-picture\" allowfullscreen></iframe></div><div class=\"detail-copy\">\n            \n            <p class=\"caption\">\n              This is a project exploring how existing 3D game mechanics can be\n              borrowed and adapted to create more intuitive and immersive\n              gameplay in mixed reality. Using the Pikmin game series as an\n              example, I reproduced various classic interactions in passthrough,\n              such as Throw and Pluck, that introduce some alternative\n              interaction patterns in XR.\n            </p>\n            <h2>\n              <a href=\"https://github.com/ellenlowing/PikminPassthrough\" target=\"_blank\">Read code</a>\n            </h2>\n          </div></article></main><footer class=\"site-footer\"><a href=\"/\">Ellen Lo</a><a href=\"mailto:ellenlowing@gmail.com\">say hi 💌</a></footer></div></body></html>"
